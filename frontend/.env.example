# =========================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (SAIGON TENNIS) - PRODUCTION DEPLOY
# =========================================================================

# 1. URL Backend chính (Quản lý Player, Tournament...)
# Nhờ Nginx Gateway làm Reverse Proxy nên có thể để RỖNG để trình duyệt tự chạy dạng relative path
# Ví dụ: Nếu web chạy ở https://saigontennistours.vn thì API sẽ tự gọi https://saigontennistours.vn/api/...
VITE_API_BASE_URL=

# 2. URL Backend Chat
# Nhờ Nginx Gateway làm Reverse Proxy nên có thể để RỖNG để trình duyệt tự chạy dạng relative path
# Ví dụ: Tự động gọi https://saigontennistours.vn/api/chat/...
VITE_API_CHAT_URL=

# 3. URL WebSocket Chat (BẮT BUỘC có scheme ws:// hoặc wss://)
# - KỊCH BẢN A (Khuyên dùng - HTTPS/SSL): wss://saigontennistours.vn
# - KỊCH BẢN B (HTTP thường): ws://saigontennistours.vn
# - KỊCH BẢN C (Chạy local/test): ws://localhost:3012
VITE_WS_CHAT_URL=wss://saigontennistours.vn